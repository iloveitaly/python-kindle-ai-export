# Kindle AI Export Environment Variables
# All variables are prefixed with KINDLE_AI_EXPORT_

# Amazon Authentication
KINDLE_AI_EXPORT_ASIN=
KINDLE_AI_EXPORT_AMAZON_EMAIL=
KINDLE_AI_EXPORT_AMAZON_PASSWORD=
KINDLE_AI_EXPORT_AMAZON_HOST=read.amazon.com
KINDLE_AI_EXPORT_MAX_SCREENS=20000
KINDLE_AI_EXPORT_HEADLESS=false
KINDLE_AI_EXPORT_RESUME=true

# AI Transcription Provider & Model
# Defaults to gemini-3.8-flash
KINDLE_AI_EXPORT_MODEL=google:gemini-3.8-flash
KINDLE_AI_EXPORT_AI_KEY=
KINDLE_AI_EXPORT_CONCURRENCY=3
KINDLE_AI_EXPORT_MAX_ATTEMPTS=100
KINDLE_AI_EXPORT_SDK_RETRIES=10
KINDLE_AI_EXPORT_TIMEOUT_MS=120000

# Export Configuration
KINDLE_AI_EXPORT_OUT_DIR=
KINDLE_AI_EXPORT_PDF_MODE=auto
KINDLE_AI_EXPORT_OUTPUT_BASENAME=

# Audio TTS Configuration
KINDLE_AI_EXPORT_TTS_ENGINE=openai
KINDLE_AI_EXPORT_OPENAI_TTS_VOICE=alloy
KINDLE_AI_EXPORT_UNREAL_SPEECH_API_KEY=
KINDLE_AI_EXPORT_UNREAL_SPEECH_VOICE=Scarlett
KINDLE_AI_EXPORT_AUDIOBOOK_PREVIEW=false
KINDLE_AI_EXPORT_FORCE=false
